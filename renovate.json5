{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
  ],

  // Target our rancher-main branch
  baseBranches: ["rancher-main"],

  // C project — only github-actions and dockerfile managers are relevant
  // (no gomod, no bundler, no npm). SUSE BCI is handled by auto-update-bci.yaml.
  enabledManagers: ["github-actions", "dockerfile"],

  // Limit concurrent PRs to avoid noise
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  schedule: ["before 6am every weekday", "every weekend"],

  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security", "vulnerability"],
    automerge: true,
    automergeType: "branch",
    schedule: ["at any time"],
  },

  packageRules: [
    // SUSE BCI base images handled by auto-update-bci.yaml — disable Renovate to avoid conflicts
    {
      matchPackageNames: [
        "registry.suse.com/bci/bci-base",
        "registry.suse.com/bci/bci-minimal",
      ],
      enabled: false,
    },

    // GitHub Actions updates — auto-merge patches and minors
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      automergeType: "branch",
      labels: ["ci", "github-actions"],
    },

    // Never auto-merge majors
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major"],
    },
  ],

  commitMessagePrefix: "chore(deps):",
  commitMessageAction: "update",

  labels: ["dependencies", "automated"],

  rebaseWhen: "behind-base-branch",
}
